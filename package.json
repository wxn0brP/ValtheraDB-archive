{
    "name": "@wxn0brp/db-plugin-crdt",
    "version": "0.120.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "description": "CRDT plugin for ValtheraDB",
    "author": "wxn0brP",
    "license": "MIT",
    "type": "module",
    "homepage": "https://github.com/wxn0brP/ValtheraDB-crdt",
    "repository": {
        "type": "git",
        "url": "https://github.com/wxn0brP/ValtheraDB-crdt.git"
    },
    "keywords": [
        "valthera",
        "valtheradb",
        "vdb-plugin",
        "crdt"
    ],
    "scripts": {
        "build": "tsc && tsc-alias"
    },
    "devDependencies": {
        "@types/bun": "*",
        "@wxn0brp/db": "^0.120.3",
        "tsc-alias": "^1",
        "typescript": "^7"
    },
    "peerDependencies": {
        "@wxn0brp/db-core": "^0.12.9"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js",
            "import": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js",
            "import": "./dist/*.js"
        }
    }
}
