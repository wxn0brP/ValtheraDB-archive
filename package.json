{
    "name": "@wxn0brp/db-storage-bin",
    "version": "0.110.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "author": "wxn0brP",
    "license": "MIT",
    "type": "module",
    "description": "ValtheraDB storage layer using a single binary file for data storage.",
    "repository": {
        "type": "git",
        "url": "https://github.com/wxn0brP/ValtheraDB-storage-bin.git"
    },
    "homepage": "https://github.com/wxn0brP/ValtheraDB-storage-bin",
    "keywords": [
        "valthera",
        "valtheradb",
        "vdb-adapter"
    ],
    "scripts": {
        "build": "tsc && tsc-alias"
    },
    "devDependencies": {
        "@types/bun": "*",
        "@wxn0brp/biome": "*",
        "tsc-alias": "^1",
        "typescript": "^7"
    },
    "dependencies": {
        "@msgpack/msgpack": "^3.1.3",
        "@wxn0brp/db-core": "^0.12.7"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js",
            "import": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js",
            "import": "./dist/*.js"
        }
    }
}
