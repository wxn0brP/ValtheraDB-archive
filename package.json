{
	"name": "@wxn0brp/db-spec-log",
	"version": "0.0.1",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"description": "Append-only log specialized adapter for ValtheraDB",
	"repository": {
		"type": "git",
		"url": "https://github.com/wxn0brP/ValtheraDB-spec-log.git"
	},
	"homepage": "https://github.com/wxn0brP/ValtheraDB-spec-log",
	"author": "wxn0brP",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "tsc && tsc-alias"
	},
	"dependencies": {
		"@wxn0brp/db-core": "^0.12.8"
	},
	"devDependencies": {
		"@types/bun": "*",
		"@wxn0brp/biome": "*",
		"tsc-alias": "^1",
		"typescript": "^7"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js",
			"default": "./dist/*.js"
		}
	}
}
