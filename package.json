{
    "name": "@wxn0brp/db-storage-sqlite",
    "version": "0.120.4",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "description": "A pure SQLite storage adapter for the ValtheraDB database library",
    "repository": {
        "type": "git",
        "url": "https://github.com/wxn0brP/ValtheraDB-storage-sqlite.git"
    },
    "homepage": "https://github.com/wxn0brP/ValtheraDB-storage-sqlite",
    "author": "wxn0brP",
    "license": "MIT",
    "type": "module",
    "keywords": [
        "valthera",
        "valtheradb",
        "vdb-adapter",
        "sqlite"
    ],
    "scripts": {
        "build": "tsc && tsc-alias"
    },
    "dependencies": {
        "@wxn0brp/db-core": "^0.12.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/bun": "*",
        "@types/node": "*",
        "@wxn0brp/biome": "*",
        "better-sqlite3": "^13.0.3",
        "tsc-alias": "^1",
        "typescript": "^7"
    },
    "peerDependencies": {
        "better-sqlite3": "^13.0.3"
    },
    "peerDependenciesMeta": {
        "better-sqlite3": {
            "optional": true
        }
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    }
}
